generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  AGENT
  VIEWER

  @@map("membership_role")
}

enum InstagramAccountStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ERROR

  @@map("instagram_account_status")
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED

  @@map("automation_status")
}

enum AutomationTriggerType {
  POST_COMMENT
  LIVE_COMMENT
  DM
  STORY_REPLY

  @@map("automation_trigger_type")
}

enum MediaScope {
  ALL
  SPECIFIC

  @@map("media_scope")
}

enum KeywordMatchType {
  EXACT
  CONTAINS
  ANY

  @@map("keyword_match_type")
}

enum WebhookEventStatus {
  RECEIVED
  QUEUED
  PROCESSED
  FAILED
  IGNORED

  @@map("webhook_event_status")
}

enum AutomationLogStatus {
  SUCCESS
  FAILED
  SKIPPED_WINDOW
  SKIPPED_COOLDOWN
  RATE_LIMITED

  @@map("automation_log_status")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELED

  @@map("subscription_status")
}

enum PaymentMethod {
  CARD_TO_CARD
  GATEWAY

  @@map("payment_method")
}

enum PaymentReceiptStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("payment_receipt_status")
}

model Workspace {
  id                String             @id @default(uuid(7)) @db.Uuid
  name              String
  slug              String             @unique
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships       Membership[]
  sessions          Session[]
  instagramAccounts InstagramAccount[]
  automationRules   AutomationRule[]
  webhookEvents     WebhookEvent[]
  automationLogs    AutomationLog[]
  subscriptions     Subscription[]
  paymentReceipts   PaymentReceipt[]

  @@map("workspaces")
}

/// Login is phone OTP (ADR-009). Instagram credentials are never stored (SEC-001).
model User {
  id               String           @id @default(uuid(7)) @db.Uuid
  phoneE164        String           @unique @map("phone_e164")
  displayName      String?          @map("display_name")
  isSuperAdmin     Boolean          @default(false) @map("is_super_admin")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships      Membership[]
  sessions         Session[]
  reviewedReceipts PaymentReceipt[] @relation("ReceiptReviewer")

  @@map("users")
}

model Membership {
  id          String         @id @default(uuid(7)) @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  role        MembershipRole
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user        User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@map("memberships")
}

/// Raw session tokens are never stored. tokenHash is SHA-256 of the cookie value.
model Session {
  id                String     @id @default(uuid(7)) @db.Uuid
  userId            String     @map("user_id") @db.Uuid
  tokenHash         String     @unique @map("token_hash")
  expiresAt         DateTime   @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime?  @map("revoked_at") @db.Timestamptz(3)
  activeWorkspaceId String?    @map("active_workspace_id") @db.Uuid
  ipHash            String?    @map("ip_hash")
  userAgent         String?    @map("user_agent")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeWorkspace   Workspace? @relation(fields: [activeWorkspaceId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@map("sessions")
}

/// Created before login, so this table has no workspace and no user foreign key.
model OtpCode {
  id         String    @id @default(uuid(7)) @db.Uuid
  phoneE164  String    @map("phone_e164")
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phoneE164, createdAt])
  @@index([phoneE164, consumedAt])
  @@map("otp_codes")
}

model InstagramAccount {
  id                 String                 @id @default(uuid(7)) @db.Uuid
  workspaceId        String                 @map("workspace_id") @db.Uuid
  igUserId           String                 @map("ig_user_id")
  username           String
  name               String?
  profilePictureUrl  String?                @map("profile_picture_url")
  followersCount     Int?                   @map("followers_count")
  accountType        String?                @map("account_type")
  accessTokenEnc     String?                @map("access_token_enc")
  tokenKeyId         String?                @map("token_key_id")
  tokenExpiresAt     DateTime?              @map("token_expires_at") @db.Timestamptz(3)
  scopes             String[]
  status             InstagramAccountStatus @default(ACTIVE)
  webhookSubscribed  Boolean                @default(false) @map("webhook_subscribed")
  connectedAt        DateTime               @default(now()) @map("connected_at") @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace          Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  automationRules    AutomationRule[]
  webhookEvents      WebhookEvent[]
  automationLogs     AutomationLog[]

  @@unique([workspaceId, igUserId])
  @@index([workspaceId])
  @@map("instagram_accounts")
}

model AutomationRule {
  id                     String                @id @default(uuid(7)) @db.Uuid
  workspaceId            String                @map("workspace_id") @db.Uuid
  instagramAccountId     String                @map("instagram_account_id") @db.Uuid
  name                   String
  status                 AutomationStatus      @default(DRAFT)
  triggerType            AutomationTriggerType @map("trigger_type")
  mediaScope             MediaScope            @default(ALL) @map("media_scope")
  mediaId                String?               @map("media_id")
  matchType              KeywordMatchType      @default(CONTAINS) @map("match_type")
  keywords               String[]
  replyText              String?               @map("reply_text")
  replyButtonsJson       Json?                 @map("reply_buttons_json")
  publicCommentReplyText String?               @map("public_comment_reply_text")
  sendPrivateReply       Boolean               @default(true) @map("send_private_reply")
  cooldownSeconds        Int                   @default(0) @map("cooldown_seconds")
  executionCount         Int                   @default(0) @map("execution_count")
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace              Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  instagramAccount       InstagramAccount      @relation(fields: [instagramAccountId], references: [id], onDelete: Restrict)
  logs                   AutomationLog[]

  @@index([workspaceId])
  @@map("automation_rules")
}

model WebhookEvent {
  id                 String             @id @default(uuid(7)) @db.Uuid
  externalEventId    String             @unique @map("external_event_id")
  workspaceId        String?            @map("workspace_id") @db.Uuid
  instagramAccountId String?            @map("instagram_account_id") @db.Uuid
  source             String             @default("INSTAGRAM")
  eventType          String             @map("event_type")
  payloadJson        Json               @map("payload_json")
  status             WebhookEventStatus @default(RECEIVED)
  errorMessage       String?            @map("error_message")
  receivedAt         DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt        DateTime?          @map("processed_at") @db.Timestamptz(3)
  workspace          Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  instagramAccount   InstagramAccount?  @relation(fields: [instagramAccountId], references: [id], onDelete: Restrict)
  logs               AutomationLog[]

  @@index([workspaceId])
  @@map("webhook_events")
}

model AutomationLog {
  id                 String               @id @default(uuid(7)) @db.Uuid
  workspaceId        String               @map("workspace_id") @db.Uuid
  instagramAccountId String               @map("instagram_account_id") @db.Uuid
  ruleId             String?              @map("rule_id") @db.Uuid
  webhookEventId     String?              @map("webhook_event_id") @db.Uuid
  igsid              String
  triggerType        AutomationTriggerType @map("trigger_type")
  matchedKeyword     String?              @map("matched_keyword")
  actionType         String               @map("action_type")
  status             AutomationLogStatus
  errorCode          String?              @map("error_code")
  errorMessage       String?              @map("error_message")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace          Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  instagramAccount   InstagramAccount     @relation(fields: [instagramAccountId], references: [id], onDelete: Restrict)
  rule               AutomationRule?      @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  webhookEvent       WebhookEvent?        @relation(fields: [webhookEventId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@map("automation_logs")
}

model Plan {
  id                    String           @id @default(uuid(7)) @db.Uuid
  code                  String           @unique
  nameFa                String           @map("name_fa")
  priceRial             BigInt           @map("price_rial")
  durationDays          Int              @map("duration_days")
  maxInstagramAccounts  Int              @map("max_instagram_accounts")
  maxMonthlyExecutions  Int              @map("max_monthly_executions")
  isActive              Boolean          @default(true) @map("is_active")
  minFollowers          Int              @default(0) @map("min_followers")
  maxFollowers          Int?             @map("max_followers")
  featuresJson          Json?            @map("features_json")
  subscriptions         Subscription[]
  paymentReceipts       PaymentReceipt[]

  @@map("plans")
}

model Subscription {
  id           String             @id @default(uuid(7)) @db.Uuid
  workspaceId  String             @map("workspace_id") @db.Uuid
  planId       String             @map("plan_id") @db.Uuid
  status       SubscriptionStatus @default(TRIAL)
  startsAt     DateTime           @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime           @map("ends_at") @db.Timestamptz(3)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  plan         Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  receipts     PaymentReceipt[]

  @@index([workspaceId])
  @@map("subscriptions")
}

model PaymentReceipt {
  id               String               @id @default(uuid(7)) @db.Uuid
  workspaceId      String               @map("workspace_id") @db.Uuid
  subscriptionId   String?              @map("subscription_id") @db.Uuid
  planId           String               @map("plan_id") @db.Uuid
  method           PaymentMethod
  amountRial       BigInt               @map("amount_rial")
  referenceCode    String               @map("reference_code")
  receiptImageUrl  String?              @map("receipt_image_url")
  status           PaymentReceiptStatus @default(PENDING)
  reviewedByUserId String?              @map("reviewed_by_user_id") @db.Uuid
  reviewNote       String?              @map("review_note")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  reviewedAt       DateTime?            @map("reviewed_at") @db.Timestamptz(3)
  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  subscription     Subscription?        @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  plan             Plan                 @relation(fields: [planId], references: [id], onDelete: Restrict)
  reviewedBy       User?                @relation("ReceiptReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@map("payment_receipts")
}
