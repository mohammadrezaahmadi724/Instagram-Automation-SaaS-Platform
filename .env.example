# ===== App =====
APP_NAME=
NEXT_PUBLIC_APP_NAME=دایرکتورا
APP_ENV=development
APP_URL=
APP_DEFAULT_LOCALE=fa
APP_TIMEZONE=Asia/Tehran

# ===== Database / Cache (ADR-002, ADR-003) =====
# Local defaults live only in an untracked .env. These lines are placeholders.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DIRECTORA_PG_PORT=55432
DIRECTORA_REDIS_PORT=56379
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/DB_NAME
REDIS_URL=redis://127.0.0.1:56379

# ===== Security =====
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_ID=

# ===== Meta / Instagram (see ADR-005, ADR-006) =====
# مقادیر واقعی فقط در `.env` محلی؛ هرگز commit نشود
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=
META_LOGIN_MODE=
INSTAGRAM_OAUTH_REDIRECT_URI=
META_WEBHOOK_VERIFY_TOKEN=
META_DATA_DELETION_CALLBACK_URL=
META_DEAUTHORIZE_CALLBACK_URL=

# ===== SMS provider (see ADR-008) =====
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=

# ===== Payment gateway (see ADR-007) =====
PAYMENT_GATEWAY=
PAYMENT_MERCHANT_ID=
PAYMENT_CALLBACK_URL=

# ===== Storage (see ADR-010) =====
STORAGE_DRIVER=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ===== Monitoring (see ADR-013) =====
LOG_LEVEL=info
ERROR_TRACKING_DSN=
